# Copy this file to .env.demo and replace EVERY placeholder before starting Demo.
# .env.demo is ignored by Git and must never be committed.

# PostgreSQL credentials for the isolated Demo database.
# Use an alphanumeric/hex value so it is safe inside the Npgsql connection string.
DEMO_POSTGRES_USER=ecommerce_demo
DEMO_POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_HEX_SECRET

# JWT signing key: at least 32 UTF-8 bytes; generate a unique random value.
DEMO_JWT_SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES

# All four passwords must be different and meet the Identity policy:
# 8+ characters, uppercase, lowercase, digit, and non-alphanumeric character.
# These example values are placeholders and MUST be replaced.
DEMO_SEED_ADMIN_PASSWORD=ReplaceThis_Admin_7!
DEMO_SEED_SELLER_PASSWORD=ReplaceThis_Seller_8!
DEMO_SEED_SECOND_SELLER_PASSWORD=ReplaceThis_Second_9!
DEMO_SEED_CUSTOMER_PASSWORD=ReplaceThis_Customer_6!

# Reset visitor activity after this many seconds (default: 24 hours).
DEMO_RESET_INTERVAL_SECONDS=86400

# Public host names allowed by ASP.NET Core Host Filtering.
# For local smoke testing, localhost and 127.0.0.1 are sufficient.
# For deployment, replace with the API's real host name(s), separated by semicolons.
DEMO_ALLOWED_HOSTS=localhost;127.0.0.1

# API is bound to loopback by default for a host-level TLS reverse proxy.
# Do not change the bind address to 0.0.0.0 unless network access is intentionally secured.
DEMO_API_BIND_ADDRESS=127.0.0.1
DEMO_API_PORT=8081

# The bridge gateway is trusted for X-Forwarded-For / X-Forwarded-Proto.
# Keep the gateway inside the configured subnet and avoid subnet conflicts on the host.
DEMO_DOCKER_SUBNET=172.30.0.0/24
DEMO_DOCKER_GATEWAY=172.30.0.1

# Interactive OpenAPI/Scalar docs are disabled unless explicitly opted in.
DEMO_API_DOCUMENTATION_ENABLED=false

# External SMTP provider. TLS is mandatory in Demo; do not use plaintext Mailpit here.
SMTP_EMAIL_HOST=smtp.example.com
SMTP_EMAIL_PORT=587
SMTP_EMAIL_SECURITY=StartTls
SMTP_EMAIL_USERNAME=
SMTP_EMAIL_PASSWORD=
SMTP_EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_EMAIL_FROM_NAME=ECommerce

# Must be an absolute HTTPS reset page URL without query string or fragment.
PASSWORD_RESET_EMAIL_FRONTEND_URL=https://demo.example.com/reset-password
