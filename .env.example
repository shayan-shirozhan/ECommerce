# Local development only. Never reuse these values outside a developer machine.
POSTGRES_PASSWORD=local-dev-password
POSTGRES_PORT=15432
JWT_SECRET_KEY=development-only-change-this-to-a-random-secret-with-at-least-32-bytes

# Development frontend origins are configured in appsettings.Development.json.
# Production-only secrets and origins must be supplied by the deployment environment,
# not copied into this file or committed to source control.

# ZarinPal integration (leave disabled until merchant credentials and URLs are configured).
# For sandbox, set ApiBaseUrl=https://sandbox.zarinpal.com and
# PaymentPageBaseUrl=https://sandbox.zarinpal.com/pg/StartPay.
# All application prices, order totals and payment amounts use Toman.
# The ZarinPal adapter converts Toman to Rials (x10) when calling the provider.
# ZarinPal__Enabled=false
# ZarinPal__MerchantId=
# ZarinPal__ApiBaseUrl=https://sandbox.zarinpal.com
# ZarinPal__PaymentPageBaseUrl=https://sandbox.zarinpal.com/pg/StartPay
# ZarinPal__CallbackUrl=https://your-public-api-host/api/payments/zarinpal/callback
