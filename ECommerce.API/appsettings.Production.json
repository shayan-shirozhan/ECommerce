{
  "Cors": {
    "AllowedOrigins": []
  },
  "Frontend": {
    "PaymentResultUrl": ""
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "OrderExpiration": {
    "PaymentWindowMinutes": 30,
    "ScanIntervalSeconds": 60,
    "ReconciliationIntervalSeconds": 120,
    "MaxVerificationAttempts": 5,
    "MaxVerificationAgeMinutes": 20
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
