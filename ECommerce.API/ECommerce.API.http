@ECommerce_API_HostAddress = https://localhost:7102

# -------------------------------------------------------------------

# Local test variables

# -------------------------------------------------------------------

@SellerToken = YOUR_SELLER_ACCESS_TOKEN
@AdminToken = YOUR_ADMIN_ACCESS_TOKEN

@ProductId = YOUR_PRODUCT_ID
@BrandId = YOUR_BRAND_ID
@CategoryId = YOUR_CATEGORY_ID
@ParentCategoryId = YOUR_PARENT_CATEGORY_ID

@ProductVariantId = YOUR_PRODUCT_VARIANT_ID
@ProductImageId = YOUR_PRODUCT_IMAGE_ID

@SellerOfferId = YOUR_SELLER_OFFER_ID
@SellerRequestId = YOUR_SELLER_REQUEST_ID

# Get the current RowVersion from GET /api/seller-offers/{id}

@SellerOfferRowVersion = YOUR_CURRENT_ROW_VERSION

# -------------------------------------------------------------------

# Authentication

# -------------------------------------------------------------------

### Login - Seller

POST {{ECommerce_API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "seller@test.com",
  "password": "Password123!"
}

###

### Login - Admin

POST {{ECommerce_API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "Password123!"
}

###

### Get Product

GET {{ECommerce_API_HostAddress}}/api/products/{{ProductId}}
Accept: application/json

###

### Create Product

POST {{ECommerce_API_HostAddress}}/api/products
Content-Type: application/json
Authorization: Bearer {{AdminToken}}

{
  "name": "Samsung S26 Ultra",
  "description": "Samsung smartphone",
  "brandId": "{{BrandId}}",
  "categoryId": "{{CategoryId}}"
}

###

### Activate Product (Admin)

PUT {{ECommerce_API_HostAddress}}/api/products/{{ProductId}}/activate
Authorization: Bearer {{AdminToken}}

###

### Deactivate Product (Admin)

PUT {{ECommerce_API_HostAddress}}/api/products/{{ProductId}}/deactivate
Authorization: Bearer {{AdminToken}}

###

### Create Product - Validation Test

POST {{ECommerce_API_HostAddress}}/api/products
Content-Type: application/json
Authorization: Bearer {{AdminToken}}

{
  "name": "",
  "description": "",
  "brandId": "00000000-0000-0000-0000-000000000000",
  "categoryId": "00000000-0000-0000-0000-000000000000"
}

# -------------------------------------------------------------------

# Brands

# -------------------------------------------------------------------

### Get Brand

GET {{ECommerce_API_HostAddress}}/api/brands/{{BrandId}}
Accept: application/json

###

### Create Brand

POST {{ECommerce_API_HostAddress}}/api/brands
Content-Type: application/json
Authorization: Bearer {{AdminToken}}

{
  "name": "Samsung"
}

# -------------------------------------------------------------------

# Categories

# -------------------------------------------------------------------

### Create Category

POST {{ECommerce_API_HostAddress}}/api/categories
Content-Type: application/json
Authorization: Bearer {{AdminToken}}

{
  "name": "TV",
  "parentCategoryId": "{{ParentCategoryId}}"
}

###

### Get Category

GET {{ECommerce_API_HostAddress}}/api/categories/{{CategoryId}}
Accept: application/json

# -------------------------------------------------------------------

# Product Variants

# -------------------------------------------------------------------

### Create Product Variant

POST {{ECommerce_API_HostAddress}}/api/product-variants
Content-Type: application/json
Authorization: Bearer {{AdminToken}}

{
  "productId": "{{ProductId}}",
  "sku": "S26-256-BLK",
  "name": "Black 256GB"
}

###

### Get Product Variant

GET {{ECommerce_API_HostAddress}}/api/product-variants/{{ProductVariantId}}
Accept: application/json

###

### Activate Product Variant (Admin)

PUT {{ECommerce_API_HostAddress}}/api/product-variants/{{ProductVariantId}}/activate
Authorization: Bearer {{AdminToken}}

###

### Deactivate Product Variant (Admin)

PUT {{ECommerce_API_HostAddress}}/api/product-variants/{{ProductVariantId}}/deactivate
Authorization: Bearer {{AdminToken}}

# -------------------------------------------------------------------

# Product Images

# -------------------------------------------------------------------

### Create Product Image

POST {{ECommerce_API_HostAddress}}/api/product-images
Content-Type: application/json
Authorization: Bearer {{AdminToken}}

{
  "productId": "{{ProductId}}",
  "productVariantId": "{{ProductVariantId}}",
  "url": "https://example.com/product-front.jpg",
  "altText": "product front view",
  "sortOrder": 1,
  "isPrimary": true
}

###

### Get Product Image

GET {{ECommerce_API_HostAddress}}/api/product-images/{{ProductImageId}}
Accept: application/json

# -------------------------------------------------------------------

# Seller Offers

# -------------------------------------------------------------------

### Create Seller Offer

POST {{ECommerce_API_HostAddress}}/api/seller-offers
Content-Type: application/json
Authorization: Bearer {{SellerToken}}

{
  "productVariantId": "{{ProductVariantId}}",
  "price": 50000000,
  "stock": 10
}

###

### Get Seller Offer

GET {{ECommerce_API_HostAddress}}/api/seller-offers/{{SellerOfferId}}
Accept: application/json

###

### Update Seller Offer Price

PUT {{ECommerce_API_HostAddress}}/api/seller-offers/price
Content-Type: application/json
Authorization: Bearer {{SellerToken}}

{
  "sellerOfferId": "{{SellerOfferId}}",
  "price": 160000,
  "rowVersion": {{SellerOfferRowVersion}}
}

###

### Update Seller Offer Stock

PUT {{ECommerce_API_HostAddress}}/api/seller-offers/stock
Content-Type: application/json
Authorization: Bearer {{SellerToken}}

{
  "sellerOfferId": "{{SellerOfferId}}",
  "stock": 20,
  "rowVersion": {{SellerOfferRowVersion}}
}

###

### Activate Seller Offer

PUT {{ECommerce_API_HostAddress}}/api/seller-offers/activate
Content-Type: application/json
Authorization: Bearer {{SellerToken}}

{
  "sellerOfferId": "{{SellerOfferId}}",
  "rowVersion": {{SellerOfferRowVersion}}
}

###

### Deactivate Seller Offer

PUT {{ECommerce_API_HostAddress}}/api/seller-offers/deactivate
Content-Type: application/json
Authorization: Bearer {{SellerToken}}

{
  "sellerOfferId": "{{SellerOfferId}}",
  "rowVersion": {{SellerOfferRowVersion}}
}

# -------------------------------------------------------------------

# Seller Requests

# -------------------------------------------------------------------

### Create Seller Request

POST {{ECommerce_API_HostAddress}}/api/seller-requests
Content-Type: application/json
Authorization: Bearer {{SellerToken}}

{
  "reason": "I want to sell TVs and mobile phones."
}

###

### Get Seller Request - Owner

GET {{ECommerce_API_HostAddress}}/api/seller-requests/{{SellerRequestId}}
Accept: application/json
Authorization: Bearer {{SellerToken}}

###

### Get Seller Request - Admin

GET {{ECommerce_API_HostAddress}}/api/seller-requests/{{SellerRequestId}}
Accept: application/json
Authorization: Bearer {{AdminToken}}

###

### Approve Seller Request - Admin

POST {{ECommerce_API_HostAddress}}/api/seller-requests/{{SellerRequestId}}/approve
Authorization: Bearer {{AdminToken}}

###

### Reject Seller Request - Admin

POST {{ECommerce_API_HostAddress}}/api/seller-requests/{{SellerRequestId}}/reject
Authorization: Bearer {{AdminToken}}
