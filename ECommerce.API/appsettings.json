{
  "Jwt": {
    "Issuer": "ECommerce.API",
    "Audience": "ECommerce.API",
    "ExpirationMinutes": 60
  },
  "RefreshTokens": {
    "ExpirationDays": 30,
    "RetentionDays": 30,
    "CleanupIntervalHours": 24,
    "RotationGracePeriodSeconds": 5
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Write": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ZarinPal": {
    "Enabled": false
  },
  "Frontend": {
    "PaymentResultUrl": "http://localhost:3000/payment-result"
  },
  "OrderExpiration": {
    "PaymentWindowMinutes": 30,
    "ScanIntervalSeconds": 60,
    "ReconciliationIntervalSeconds": 120,
    "MaxVerificationAttempts": 5,
    "MaxVerificationAgeMinutes": 20
  },
  "PasswordResetEmail": {
    "TokenLifespanMinutes": 30
  },
  "SmtpEmail": {
    "Enabled": false,
    "Port": 587,
    "Security": "StartTls",
    "TimeoutSeconds": 15,
    "FromName": "ECommerce"
  },
  "DemoReset": {
    "IntervalSeconds": 86400
  }
}
